# ============================================================
# MODÈLE des variables d'environnement (aucun secret ici).
#
# Les vraies valeurs sont dans .env.enc (chiffré avec SOPS).
# Pour démarrer la plateforme : .\infra\secrets\start.ps1
# Détails : infra/secrets/README.md
#
# Ce fichier sert à deux choses :
#  1. Documenter les variables dont le projet a besoin.
#  2. Servir de valeur par défaut à Docker Compose (ENV_FILE) pour
#     les commandes simples (ps, logs, exec) lancées sans start.ps1.
#
# Ne jamais démarrer la plateforme avec ce fichier : les valeurs
# CHANGE_ME sont factices. Ne jamais y écrire un vrai secret.
# ============================================================

DEMO_USER_PASSWORD=CHANGE_ME
API_URL=CHANGE_ME
DATABASE_URL=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
PGADMIN_EMAIL=CHANGE_ME
PGADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
ALGORITHM=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
